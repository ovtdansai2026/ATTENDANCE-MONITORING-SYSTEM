# ==============================================================================
# 🛡️ Whitelist .gitignore: Track ONLY files needed for GitHub Pages
# ==============================================================================

# 1. Ignore everything by default
*

# 2. Whitelist: Keep ONLY public dashboard & recheck files
!/.gitignore
!/index.html
!/logo.png
!/README.md
!/CHECKLIST.md
!/HANDOFF.md
!/vercel.json
!/admin-module.js
!/stickman-bot.js
!/google_apps_script_backup.js
!/recheck/
!/recheck/**

# 3. Explicitly block sensitive & internal directories/files
data/
uploads/
attendance-dashboard/
.github/
api/
node_modules/
*.sql
*.cmd
server.js
serve.js
*.env*
*.log
google-service-account.json
credentials.json
.DS_Store
Thumbs.db
